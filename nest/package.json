{
  "name": "multithreading-lab-nest",
  "version": "1.0.0",
  "description": "NestJS + Fastify word-search implementation (worker_threads pool)",
  "private": true,
  "scripts": {
    "generate": "openapi-typescript ../openapi.yaml --default-non-nullable false -o src/generated/api.d.ts",
    "prebuild": "npm run generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "pretest": "npm run generate",
    "test": "jest test/search.spec.ts",
    "test:integration": "npm run build && jest test/worker-pool.spec.ts test/api.spec.ts test/modes.spec.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "fastify": "^5.12.5",
    "js-yaml": "^5.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unidecode": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.4.14",
    "typescript": "^7.0.2"
  }
}
